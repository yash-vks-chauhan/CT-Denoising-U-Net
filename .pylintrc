[MAIN]
extension-pkg-allow-list=cv2
ignored-modules=tensorflow,skimage.metrics

[MESSAGES CONTROL]
disable=line-too-long,
        invalid-name,
        too-many-locals,
        too-many-return-statements,
        too-many-arguments,
        too-many-positional-arguments,
        too-many-statements

[TYPECHECK]
generated-members=tf.keras,tf.keras.*,tensorflow.keras,tensorflow.keras.*,cv2,cv2.*
